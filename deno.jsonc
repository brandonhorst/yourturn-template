{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "dev:vite": "vite --clearScreen false",
    "dev": {
      "command": "deno task dev:vite & deno task start",
      "dependencies": ["build"]
    }
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "links": [
    "../yourturn"
  ],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/random": "jsr:@std/random@^0.1.5",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.25",
    "daisyui": "npm:daisyui@^5.5.19",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "lucide-preact": "npm:lucide-preact@^0.575.0",
    "preact": "npm:preact@^10.28.4",
    "@preact/signals": "npm:@preact/signals@^2.8.1",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "vite": "npm:vite@^7.3.1",
    "tailwindcss": "npm:tailwindcss@^4.2.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.1",
    "yourturn/client": "jsr:@brandonhorst/yourturn@0.13.0/client",
    "yourturn/server": "jsr:@brandonhorst/yourturn@0.13.0/server",
    "yourturn/types": "jsr:@brandonhorst/yourturn@0.13.0/types",
    "immer": "npm:immer@^11.1.4"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "unstable": ["kv"],
  "lock": false
}
